{
  "name": "@shdwsdk/sdk",
  "version": "2.0.0",
  "description": "Resilient, non-blocking Scope 3 AI carbon telemetry and AI-BOM SDK for OpenAI, Anthropic, Google Gemini and OpenTelemetry. MIT-licensed, zero dependencies.",
  "homepage": "https://www.shdwsdk.ai/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shdwaibuild/shdwsdk-js.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/shdwaibuild/shdwsdk-js/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shdw-sdk": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    },
    "./scanner": {
      "types": "./dist/scanner.d.ts",
      "import": "./dist/scanner.js",
      "require": "./dist/cjs/scanner.js",
      "default": "./dist/scanner.js"
    },
    "./database.types": {
      "types": "./dist/database.types.d.ts",
      "import": "./dist/database.types.js",
      "require": "./dist/cjs/database.types.js",
      "default": "./dist/database.types.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "keywords": [
    "ai-carbon",
    "scope-3",
    "ml-energy",
    "ai-bom",
    "openai",
    "anthropic",
    "gemini",
    "telemetry"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
